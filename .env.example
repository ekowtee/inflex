# Database — Neon (https://console.neon.tech)
# After creating a project, copy the "pooled" connection string here.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials
# ADMIN_PASSWORD can be a plain string for local dev, or a bcrypt hash for production.
# To generate a bcrypt hash: `node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_EMAIL="admin@inflexions.tech"

# Cloudflare Turnstile (public contact form CAPTCHA).
# Sign up at https://dash.cloudflare.com/?to=/:account/turnstile — free,
# unlimited, privacy-friendly. Add the public site key (safe to expose) and
# the server-side secret. Leave both blank to disable the captcha in dev
# (the form still works; only the honeypot guards against bots).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
