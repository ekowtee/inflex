{
  "name": "inflexionsweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:deploy:prod": "node scripts/prisma-prod.mjs migrate deploy",
    "db:studio:prod": "node scripts/prisma-prod.mjs studio",
    "db:status:prod": "node scripts/prisma-prod.mjs migrate status",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed:prod": "node scripts/prisma-prod.mjs db seed",
    "test": "tsx --test src/lib/__tests__/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/fiber": "^9.7.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "three": "^0.186.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "chrome-launcher": "^1.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "lighthouse": "^12.8.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
