# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Image originals kept out of the served folder (PERFORMANCE_PLAN.md §6.1).
# assets-src/originals/ IS committed: those are the masters for every image
# still in use, so a future re-encode never needs git history.
# assets-src/unreferenced/ is NOT committed: nothing in the site uses these
# files. Archive them elsewhere before deleting the working copy.
assets-src/unreferenced/

# Phase 0 scratch output (screenshots, payload snapshots)
.phase0/
